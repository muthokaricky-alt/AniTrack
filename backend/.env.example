PORT=5000
# Generate a real one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# Your Neon connection string (Neon dashboard > Connect). Keep it secret: never commit .env
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional
# If your network blocks Postgres (port 5432) and the server times out connecting, uncomment this line (local use only):
# NEON_WEBSOCKET=1
# CORS_ORIGIN=https://your-frontend-host.example
# Backup catalogue (MyAnimeList via the free Jikan API), used for browse, search and detail pages while AniList is down.
# Set to "off" to disable it.
# BACKUP_SOURCE=off
# How AniTrack introduces itself to AniList and Jikan (set this to your own site address once you have a domain):
# ANILIST_USER_AGENT=AniTrack/1.0 (+https://your-site.example)
